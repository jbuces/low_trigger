universe     = vanilla
executable   = /lhome/ext/ucm147/ucm1473/miniconda3/bin/conda
getenv       = True

# Arguments: use $(l1), $(pts), and $(run) macros
arguments = run --name ctlearn --no-capture-output python /lhome/ext/ucm147/ucm1473/lowtrigger_stats/scripts/get_l1tdscan.py \
  -i /lustre/ific.uv.es/ml/ucm147/datasets/TriggerlessData/gammas_prediction/corsika_run$(run).r0.h5 \
  -o /lustre/ific.uv.es/ml/ucm147/datasets/TriggerlessData/gammas_prediction/triggers/run$(run)/tdscan/$(l1)_$(pts)/corsika_run$(run)_$(l1)cut_tdscan$(pts).h5 \
  -nf /lhome/ext/ucm147/ucm1473/dl1-data-handler/dl1_data_handler/ressources/newcam_sipm_patches.h5 \
  -pts $(pts) \
  -l1 $(l1) \
  -epsl1 $(epsl1) \
  -trig tdscan \
  -epst 1 \
  -add False \
  -qstep 0

log    = /lustre/ific.uv.es/ml/ucm147/datasets/TriggerlessData/gammas_prediction/triggers/run$(run)/tdscan/$(l1)_$(pts)/l1tdscan.log
output = /lustre/ific.uv.es/ml/ucm147/datasets/TriggerlessData/gammas_prediction/triggers/run$(run)/tdscan/$(l1)_$(pts)/output.$(Cluster).$(Process).out
error  = /lustre/ific.uv.es/ml/ucm147/datasets/TriggerlessData/gammas_prediction/triggers/run$(run)/tdscan/$(l1)_$(pts)/error.$(Cluster).$(Process).err

request_cpus    = 4
request_memory  = 32G
request_disk    = 32G

